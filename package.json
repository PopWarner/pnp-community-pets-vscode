{
    "name": "pnp-community-pets",
    "displayName": "PnP Community Pets",
    "description": "Animated M365 and Power Platform mascots for your VS Code editor",
    "version": "0.0.1",
    "publisher": "WarnerDigital",
    "license": "MIT",
    "preview": true,
    "icon": "media/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/PopWarner/pnp-community-pets-vscode"
    },
    "bugs": {
        "url": "https://github.com/PopWarner/pnp-community-pets-vscode/issues"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": ["Other"],
    "keywords": ["pets", "mascots", "m365", "pnp", "power-platform", "community"],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "views": {
            "explorer": [
                {
                    "type": "webview",
                    "id": "pnpPets.petView",
                    "name": "PnP Community Pets"
                }
            ]
        },
        "commands": [
            {
                "command": "pnpPets.spawnPet",
                "title": "Spawn a Pet",
                "category": "PnP Pets",
                "icon": "$(add)"
            },
            {
                "command": "pnpPets.removeAllPets",
                "title": "Remove All Pets",
                "category": "PnP Pets",
                "icon": "$(trash)"
            },
            {
                "command": "pnpPets.removePet",
                "title": "Remove a Pet",
                "category": "PnP Pets"
            },
            {
                "command": "pnpPets.adjustPetSpeed",
                "title": "Adjust Pet Speed",
                "category": "PnP Pets"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "pnpPets.spawnPet",
                    "when": "view == pnpPets.petView",
                    "group": "navigation"
                },
                {
                    "command": "pnpPets.removeAllPets",
                    "when": "view == pnpPets.petView",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "PnP Community Pets",
            "properties": {
                "pnpPets.mascot": {
                    "type": "string",
                    "default": "parker",
                    "description": "The mascot to display in the pet panel"
                },
                "pnpPets.theme": {
                    "type": "string",
                    "default": "auto",
                    "enum": ["auto", "default", "winter", "spring", "halloween", "ignite", "build"],
                    "enumDescriptions": [
                        "Automatically picks a theme based on the current date",
                        "Default VS Code background",
                        "Winter holiday theme",
                        "Spring theme",
                        "Halloween theme",
                        "Microsoft Ignite theme",
                        "Microsoft Build theme"
                    ],
                    "description": "The background theme for the pet panel"
                },
                "pnpPets.speed": {
                    "type": "number",
                    "default": 2,
                    "minimum": 1,
                    "maximum": 10,
                    "description": "Movement speed of pets (1 = slow, 10 = fast)"
                },
                "pnpPets.petCount": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "maximum": 10,
                    "description": "Number of pets to spawn"
                },
                "pnpPets.persistPets": {
                    "type": "boolean",
                    "default": true,
                    "description": "Remember which pets are on screen and restore them when VS Code reopens"
                },
                "pnpPets.enableEventReactions": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show temporary emotes when VS Code events happen, such as saving files, opening terminals, ending tasks, or debugging"
                },
                "pnpPets.eventReactions.fileSaved.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show an event emote when a file is saved"
                },
                "pnpPets.eventReactions.fileSaved.emoteId": {
                    "type": "string",
                    "default": "sparkle",
                    "enum": ["approved", "branch", "breakpoint", "bug", "checkmark", "coffee", "crown", "exclamation", "eyes", "fire", "heart", "hmm", "hourglass", "lightbulb", "lightning", "new", "nice", "oops", "party-popper", "pencil", "question-mark", "rocket", "ship-it", "sleep", "sparkle", "star", "stop", "terminal", "trash", "trophy", "warning", "wave", "x-mark"],
                    "description": "Emote shown when a file is saved"
                },
                "pnpPets.eventReactions.fileSaved.target": {
                    "type": "string",
                    "default": "random",
                    "enum": ["random", "all"],
                    "enumDescriptions": ["One random active pet reacts", "All active pets react"],
                    "description": "Which pets react when a file is saved"
                },
                "pnpPets.eventReactions.fileSaved.bounce": {
                    "type": "boolean",
                    "default": true,
                    "description": "Bounce the pet when a file-saved emote appears"
                },
                "pnpPets.eventReactions.taskSucceeded.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show an event emote when a VS Code task succeeds"
                },
                "pnpPets.eventReactions.taskSucceeded.emoteId": {
                    "type": "string",
                    "default": "checkmark",
                    "enum": ["approved", "branch", "breakpoint", "bug", "checkmark", "coffee", "crown", "exclamation", "eyes", "fire", "heart", "hmm", "hourglass", "lightbulb", "lightning", "new", "nice", "oops", "party-popper", "pencil", "question-mark", "rocket", "ship-it", "sleep", "sparkle", "star", "stop", "terminal", "trash", "trophy", "warning", "wave", "x-mark"],
                    "description": "Emote shown when a VS Code task succeeds"
                },
                "pnpPets.eventReactions.taskSucceeded.target": {
                    "type": "string",
                    "default": "random",
                    "enum": ["random", "all"],
                    "enumDescriptions": ["One random active pet reacts", "All active pets react"],
                    "description": "Which pets react when a VS Code task succeeds"
                },
                "pnpPets.eventReactions.taskSucceeded.bounce": {
                    "type": "boolean",
                    "default": true,
                    "description": "Bounce the pet when a task-success emote appears"
                },
                "pnpPets.eventReactions.taskFailed.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show an event emote when a VS Code task fails"
                },
                "pnpPets.eventReactions.taskFailed.emoteId": {
                    "type": "string",
                    "default": "x-mark",
                    "enum": ["approved", "branch", "breakpoint", "bug", "checkmark", "coffee", "crown", "exclamation", "eyes", "fire", "heart", "hmm", "hourglass", "lightbulb", "lightning", "new", "nice", "oops", "party-popper", "pencil", "question-mark", "rocket", "ship-it", "sleep", "sparkle", "star", "stop", "terminal", "trash", "trophy", "warning", "wave", "x-mark"],
                    "description": "Emote shown when a VS Code task fails"
                },
                "pnpPets.eventReactions.taskFailed.target": {
                    "type": "string",
                    "default": "random",
                    "enum": ["random", "all"],
                    "enumDescriptions": ["One random active pet reacts", "All active pets react"],
                    "description": "Which pets react when a VS Code task fails"
                },
                "pnpPets.eventReactions.taskFailed.bounce": {
                    "type": "boolean",
                    "default": true,
                    "description": "Bounce the pet when a task-failure emote appears"
                },
                "pnpPets.eventReactions.terminalOpened.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show an event emote when a terminal is opened"
                },
                "pnpPets.eventReactions.terminalOpened.emoteId": {
                    "type": "string",
                    "default": "terminal",
                    "enum": ["approved", "branch", "breakpoint", "bug", "checkmark", "coffee", "crown", "exclamation", "eyes", "fire", "heart", "hmm", "hourglass", "lightbulb", "lightning", "new", "nice", "oops", "party-popper", "pencil", "question-mark", "rocket", "ship-it", "sleep", "sparkle", "star", "stop", "terminal", "trash", "trophy", "warning", "wave", "x-mark"],
                    "description": "Emote shown when a terminal is opened"
                },
                "pnpPets.eventReactions.terminalOpened.target": {
                    "type": "string",
                    "default": "random",
                    "enum": ["random", "all"],
                    "enumDescriptions": ["One random active pet reacts", "All active pets react"],
                    "description": "Which pets react when a terminal is opened"
                },
                "pnpPets.eventReactions.terminalOpened.bounce": {
                    "type": "boolean",
                    "default": true,
                    "description": "Bounce the pet when a terminal-opened emote appears"
                },
                "pnpPets.eventReactions.debugStarted.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show an event emote when debugging starts"
                },
                "pnpPets.eventReactions.debugStarted.emoteId": {
                    "type": "string",
                    "default": "bug",
                    "enum": ["approved", "branch", "breakpoint", "bug", "checkmark", "coffee", "crown", "exclamation", "eyes", "fire", "heart", "hmm", "hourglass", "lightbulb", "lightning", "new", "nice", "oops", "party-popper", "pencil", "question-mark", "rocket", "ship-it", "sleep", "sparkle", "star", "stop", "terminal", "trash", "trophy", "warning", "wave", "x-mark"],
                    "description": "Emote shown when debugging starts"
                },
                "pnpPets.eventReactions.debugStarted.target": {
                    "type": "string",
                    "default": "random",
                    "enum": ["random", "all"],
                    "enumDescriptions": ["One random active pet reacts", "All active pets react"],
                    "description": "Which pets react when debugging starts"
                },
                "pnpPets.eventReactions.debugStarted.bounce": {
                    "type": "boolean",
                    "default": true,
                    "description": "Bounce the pet when a debug-started emote appears"
                },
                "pnpPets.eventReactions.debugStopped.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show an event emote when debugging stops"
                },
                "pnpPets.eventReactions.debugStopped.emoteId": {
                    "type": "string",
                    "default": "stop",
                    "enum": ["approved", "branch", "breakpoint", "bug", "checkmark", "coffee", "crown", "exclamation", "eyes", "fire", "heart", "hmm", "hourglass", "lightbulb", "lightning", "new", "nice", "oops", "party-popper", "pencil", "question-mark", "rocket", "ship-it", "sleep", "sparkle", "star", "stop", "terminal", "trash", "trophy", "warning", "wave", "x-mark"],
                    "description": "Emote shown when debugging stops"
                },
                "pnpPets.eventReactions.debugStopped.target": {
                    "type": "string",
                    "default": "random",
                    "enum": ["random", "all"],
                    "enumDescriptions": ["One random active pet reacts", "All active pets react"],
                    "description": "Which pets react when debugging stops"
                },
                "pnpPets.eventReactions.debugStopped.bounce": {
                    "type": "boolean",
                    "default": false,
                    "description": "Bounce the pet when a debug-stopped emote appears"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/node": "18.x",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "typescript": "^5.3.0",
        "@vscode/vsce": "^2.22.0"
    }
}
